{
  "name": "@qntx/nostr",
  "version": "0.9.0",
  "description": "Nostr protocol implementation and SDK in TypeScript",
  "keywords": [
    "decentralized",
    "nip",
    "nostr",
    "relay",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/qntx/nostr#readme",
  "bugs": {
    "url": "https://github.com/qntx/nostr/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
