  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:wasm": "bash scripts/build-wasm.sh && WASM_PACK=1 vp pack && ls dist/*.wasm >/dev/null && publint && attw --pack . --profile esm-only",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:wasm": "WASM_TEST=1 vp test wasm-tests/verify.ts wasm-tests/node-load.ts wasm-tests/sign.ts wasm-tests/browser-entry.ts",
    "bench:wasm": "WASM_TEST=1 vp test wasm-tests/bench.ts",
    "bench:store": "BENCH=1 vp test bench/reactive-store.bench.ts",
    "bench:store:sqlite": "BENCH=1 vp test bench/sqlite-store.bench.ts",
    "bench:nip27": "BENCH=1 vp test bench/nip27.bench.ts",
    "lint": "vp check && taplo fmt --check && bun scripts/check-version.ts && bun scripts/check-layers.ts && bun scripts/parity/check.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "smoke:hermes": "bun scripts/hermes-smoke.ts",
    "check:pkg": "WASM_PACK=1 vp pack && publint && attw --pack . --profile esm-only",
    "prepublishOnly": "bun run build:wasm",
    "pack:local": "vp pack && bun pm pack",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@taplo/cli": "0.7.0",
    "@types/node": "26.6.3",
    "@types/ws": "8.18.2",
    "binaryen": "132.0.0",
    "buffer": "6.0.3",
    "bumpp": "12.3.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "whatwg-url": "7.1.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
