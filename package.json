{
  "name": "@qntx/nostr-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/nostr.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp check && taplo fmt --check && bun scripts/check-version.ts && bun scripts/check-layers.ts && bun scripts/check-features.ts && bun scripts/parity/check.ts",
    "typecheck": "vp run -r typecheck && tsc --noEmit",
    "build": "vp run -r build",
    "test": "vp run -r test && vp test",
    "test:parity": "bun packages/nostr/scripts/parity/diff.ts --seed 42 --count 2000 --out target/parity && NK_DIFF_DIR=target/parity cargo test -p nk-vectors --test diff -- --ignored",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@taplo/cli": "0.7.0",
    "@types/node": "26.6.3",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
