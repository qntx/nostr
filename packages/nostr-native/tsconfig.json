{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Development resolution for the workspace sibling without a prior pack
    // build; the emitted package keeps importing @qntx/nostr/* (peer dep).
    "paths": {
      "@qntx/nostr": ["../nostr/src/index.ts"],
      "@qntx/nostr/core": ["../nostr/src/core/index.ts"],
      // See types/react-native.d.ts: keeps RN's global augmentations out of
      // this program so the mapped nostr sources still typecheck.
      "react-native": ["./types/react-native.d.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"]
}
