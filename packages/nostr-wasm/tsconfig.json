{
  "extends": "@qntx/tsconfig/configs/strictest.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // Development resolution for the workspace sibling without a prior pack
    // build; the emitted package keeps importing @qntx/nostr/* (peer dep).
    "paths": {
      "@qntx/nostr": ["../nostr/src/index.ts"],
      "@qntx/nostr/core": ["../nostr/src/core/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
