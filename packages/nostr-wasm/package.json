{
  "name": "@qntx/nostr-wasm",
  "version": "0.10.1",
  "description": "WebAssembly-accelerated cryptography backend for @qntx/nostr",
  "keywords": [
    "nostr",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/qntx/nostr#readme",
  "bugs": {
    "url": "https://github.com/qntx/nostr/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/nostr.git",
    "directory": "packages/nostr-wasm"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.wasm"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "vp run @qntx/nostr#build && bash scripts/build.sh && vp pack && publint && attw --pack . --profile esm-only",
    "test:wasm": "vp test",
    "bench:wasm": "BENCH=1 vp test tests/bench.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "check:pkg": "vp run @qntx/nostr#build && vp pack && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@noble/curves": "2.4.0",
    "@qntx/nostr": "0.10.1",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.3",
    "binaryen": "132.0.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@qntx/nostr": "^0.10.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
